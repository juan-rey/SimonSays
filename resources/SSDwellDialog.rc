// The shared Gaze / Dwell-click window's dialog template (dwell.spec.md
// REQ-F62, REQ-F109), in a file of its own so that another host can include
// it. Moved unchanged from SimonSays.rc, which includes it through its
// TEXTINCLUDE 3 block. The including script must include resource.h first
// (the IDD_DWELL_DIALOG and IDC_DWELL_* ids).
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Two columns at 10 pt, like Settings (dwell.spec.md REQ-N09, section 11):
// mode and tuning on the left; detection probes and signals on the right.
IDD_DWELL_DIALOG DIALOGEX 0, 0, 496, 255
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Gaze / Dwell-click"
FONT 10, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Activate buttons by looking at them.",IDC_DWELL_INTRO,7,7,236,16
    GROUPBOX        "Activation mode",IDC_DWELL_MODE_GROUP,7,26,236,44
    AUTORADIOBUTTON "Automatic",IDC_DWELL_MODE_AUTO,14,38,110,10,WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Mouse cursor",IDC_DWELL_MODE_MOUSE,124,38,115,10
    AUTORADIOBUTTON "HID eye tracker",IDC_DWELL_MODE_HID,14,54,110,10
    AUTORADIOBUTTON "Off",IDC_DWELL_MODE_OFF,124,54,115,10
    LTEXT           "Lock-on delay (ms)",IDC_DWELL_LOCKON_LABEL,7,76,186,8,WS_GROUP
    CONTROL         "",IDC_DWELL_LOCKON_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,7,86,186,18
    EDITTEXT        IDC_DWELL_LOCKON_EDIT,198,86,45,12,ES_NUMBER
    LTEXT           "Dwell time",IDC_DWELL_TIME_LABEL,7,106,186,8
    CONTROL         "",IDC_DWELL_TIME_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,7,116,186,18
    EDITTEXT        IDC_DWELL_TIME_EDIT,198,116,45,12,ES_NUMBER
    LTEXT           "Tolerance",IDC_DWELL_TOLERANCE_LABEL,7,136,186,8
    CONTROL         "",IDC_DWELL_TOLERANCE_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,7,146,186,18
    EDITTEXT        IDC_DWELL_TOLERANCE_EDIT,198,146,45,12,ES_NUMBER
    LTEXT           "Cooldown",IDC_DWELL_COOLDOWN_LABEL,7,166,186,8
    CONTROL         "",IDC_DWELL_COOLDOWN_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,7,176,186,18
    EDITTEXT        IDC_DWELL_COOLDOWN_EDIT,198,176,45,12,ES_NUMBER
    PUSHBUTTON      "Progress color...",IDC_DWELL_COLOR_BUTTON,7,196,110,14
    CONTROL         "Move away before dwell can activate again",IDC_DWELL_REARM_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,214,236,10
    GROUPBOX        "Detect how you use the tracker",IDC_DWELL_DETECT_GROUP,253,7,236,90
    LTEXT           "",IDC_DWELL_PROBE_LOOK_AREA,260,19,108,46
    LTEXT           "",IDC_DWELL_PROBE_MOUSE_AREA,374,19,108,46
    LTEXT           "",IDC_DWELL_STATUS,260,69,222,22
    GROUPBOX        "Detected",IDC_DWELL_SIGNALS_GROUP,253,101,236,56
    LTEXT           "",IDC_DWELL_SIGNAL_HID,260,113,222,10
    LTEXT           "",IDC_DWELL_SIGNAL_TOOL,260,125,222,10
    LTEXT           "",IDC_DWELL_SIGNAL_WEC,260,137,222,10
    PUSHBUTTON      "Save diagnostic report...",IDC_DWELL_DUMP_BUTTON,253,163,140,14
    PUSHBUTTON      "Reset",IDC_DWELL_RESET,7,234,70,14
    DEFPUSHBUTTON   "OK",IDOK,385,234,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,439,234,50,14
END
