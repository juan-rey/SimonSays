IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About SimonSays"
FONT 10, "Segoe UI Light", 300, 0, 0x0
BEGIN
    ICON            IDI_SIMONSAYS,IDC_STATIC,14,14,18,15
    LTEXT           "SimonSays Version 0.7.1",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

// Two columns at 10 pt (settings.spec.md section 11): default text, category window
// and the dwell button on the left; language, voice, sound output and the
// playback checkboxes on the right. Left is 225 DLU (the narrowest that fits
// its longest translated label, Russian auto-resize, on one line); right keeps
// the old single column's 236 DLU for the long playback labels.
IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 485, 234
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 10, "Segoe UI", 0, 0, 0x1
BEGIN
    LTEXT           "Default text:",IDC_SETTINGS_LABEL_DEFAULT_TEXT,7,7,225,8
    EDITTEXT        IDC_SETTINGS_DEFAULT_TEXT,7,17,225,48,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    CONTROL         "Insert default text automatically",IDC_SETTINGS_USE_DEFAULT_TEXT,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,68,225,10
    CONTROL         "Show Touch Keyboard",IDC_SETTINGS_SHOW_TOUCH_KEYBOARD,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,80,225,10
    CONTROL         "Show quick access buttons and menu",IDC_SETTINGS_SHOW_QUICK_BUTTONS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,92,225,10
    CONTROL         "Minimize category window automatically",IDC_SETTINGS_MINIMIZE_CATEGORY_WINDOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,108,225,12
    CONTROL         "Remember category window size",IDC_SETTINGS_REMEMBER_CATEGORY_WINDOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,122,225,12
    CONTROL         "Auto-resize category window to fit content",IDC_SETTINGS_AUTORESIZE_CATEGORY_WINDOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,136,225,12
    PUSHBUTTON      "Gaze / Dwell-click...",IDC_SETTINGS_DWELL_SETTINGS,7,156,120,14
    LTEXT           "Language:",IDC_SETTINGS_LABEL_LANGUAGE,242,7,113,8
    COMBOBOX        IDC_SETTINGS_LANGUAGE_COMBO,242,17,113,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Voice:",IDC_SETTINGS_LABEL_VOICE,365,7,113,8
    COMBOBOX        IDC_SETTINGS_VOICE_COMBO,365,17,113,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Test Voice",IDC_SETTINGS_TEST_VOICE,365,34,113,14
    LTEXT           "Volume (10-100):",IDC_SETTINGS_LABEL_VOLUME,242,53,236,8
    EDITTEXT        IDC_SETTINGS_VOLUME_EDIT,433,64,45,12,ES_NUMBER
    CONTROL         "",IDC_SETTINGS_VOLUME_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,242,63,186,18
    LTEXT           "Rate (-10 to 10):",IDC_SETTINGS_LABEL_RATE,242,85,236,8
    EDITTEXT        IDC_SETTINGS_RATE_EDIT,433,96,45,12,ES_AUTOHSCROLL
    CONTROL         "",IDC_SETTINGS_RATE_SLIDER,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,242,95,186,18
    LTEXT           "Sound output:",IDC_SETTINGS_LABEL_OUTPUT_DEVICE,242,117,236,8
    COMBOBOX        IDC_SETTINGS_OUTPUT_DEVICE_COMBO,242,127,150,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Listen settings...",IDC_SETTINGS_LISTEN_SETTINGS,397,126,81,14
    CONTROL         "Speak phrase immediately when selecting",IDC_SETTINGS_SPEAK_ON_CLICK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,242,149,236,12
    CONTROL         "Stop Previous Playback",IDC_SETTINGS_STOP_PREVIOUS_PLAYBACK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,242,163,236,12
    CONTROL         "Increase SimonSays volume when playing",IDC_SETTINGS_INCREASE_VOLUME_WHEN_PLAYING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,242,177,236,12
    CONTROL         "Temporarily reduce other audio when playing",IDC_SETTINGS_REDUCE_OTHER_AUDIO_WHEN_PLAYING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,242,191,236,12
    PUSHBUTTON      "Help",IDC_SETTINGS_HELP,7,213,50,14
    DEFPUSHBUTTON   "OK",IDOK,374,213,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,428,213,50,14
END

IDD_EDIT_DIALOG DIALOGEX 0, 0, 221, 88
